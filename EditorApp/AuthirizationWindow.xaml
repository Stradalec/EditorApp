<Window x:Class="EditorApp.AuthirizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EditorApp"
        mc:Ignorable="d"
        Title="Зарегистрировать программу" Height="340" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppWindowBackground}">
    <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <Label Content="Имя пользователя"
         Target="{Binding ElementName=UserNameBox}"
         Style="{StaticResource FormLabel}"/>
      <TextBox x:Name="UserNameBox"
           Style="{StaticResource FormTextBox}"
           Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <Label Content="Код приглашения"
         Target="{Binding ElementName=InviteCodeBox}"
         Style="{StaticResource FormLabel}"/>
      <TextBox x:Name="InviteCodeBox"
           Style="{StaticResource FormTextBox}"
           Text="{Binding InviteCode, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>

    <Button Grid.Row="3"
        Content="Зарегистрироваться"
        Command="{Binding RegisterCommand}"
        Style="{StaticResource FormPrimaryButton}"
        HorizontalAlignment="Stretch"/>
  </Grid>
</Window>
