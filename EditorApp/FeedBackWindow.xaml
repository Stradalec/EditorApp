<Window x:Class="EditorApp.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка форматирования"
        Width="620"
        Height="560"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CloseButton"
                        Content="Закрыть"
                        IsCancel="True"
                        Padding="12,5"/>
        <Button x:Name="SendButton"
                        Content="Отправить"
                        Click="Send_Click"
                        Margin="8,0,0,0"
                        Padding="12,5"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields">
        <Label Content="Тип источника" Target="{Binding ElementName=SourceTypeBox}"/>
        <TextBox x:Name="SourceTypeBox"/>

        <Label Content="Исходная запись"
                       Target="{Binding ElementName=OriginalTextBox}"
                       Margin="0,10,0,0"/>
        <TextBox x:Name="OriginalTextBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

        <Label Content="Результат модели"
                       Target="{Binding ElementName=ModelOutputBox}"
                       Margin="0,10,0,0"/>
        <TextBox x:Name="ModelOutputBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

        <Label Content="Как должно быть"
                       Target="{Binding ElementName=ExpectedOutputBox}"
                       Margin="0,10,0,0"/>
        <TextBox x:Name="ExpectedOutputBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>