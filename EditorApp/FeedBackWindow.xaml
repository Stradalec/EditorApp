<Window x:Class="EditorApp.FeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ошибка форматирования"
        Width="620"
        Height="620"
        MinWidth="420"
        MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppWindowBackground}">
  <DockPanel Margin="30" LastChildFill="True">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText"
                       Margin="0,0,0,8"
                       TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CloseButton"
          Content="Закрыть"
          IsCancel="True"
          Style="{StaticResource FormButton}"/>
        <Button x:Name="SendButton"
          Content="Отправить"
          Click="Send_Click"
          Margin="8,0,0,0"
          Style="{StaticResource FormPrimaryButton}"/>
      </StackPanel>
    </StackPanel>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Fields">
        <StackPanel.Resources>
          <Style TargetType="{x:Type Label}" BasedOn="{StaticResource FormLabel}"/>
          <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource FormTextBox}"/>
        </StackPanel.Resources>
        <Label Content="Тип источника" Target="{Binding ElementName=SourceTypeBox}"/>
        <ComboBox x:Name="SourceTypeBox"
          SelectedValuePath="Tag"
          MinHeight="36"
          FontSize="16"
          Padding="9,6">
          <ComboBoxItem Content="Книга" Tag="book"/>
          <ComboBoxItem Content="Статья в журнале" Tag="journal"/>
          <ComboBoxItem Content="Статья в сборнике" Tag="proceedings"/>
          <ComboBoxItem Content="Патент" Tag="patent"/>
          <ComboBoxItem Content="Стандарт" Tag="standard"/>
          <ComboBoxItem Content="Закон / нормативный акт" Tag="law"/>
          <ComboBoxItem Content="Диссертация" Tag="dissertation"/>
          <ComboBoxItem Content="Сайт целиком" Tag="website"/>
          <ComboBoxItem Content="Страница сайта" Tag="webpage"/>
        </ComboBox>

        <Label Content="Исходная запись"
                       Target="{Binding ElementName=OriginalTextBox}"
                       Margin="0,10,0,0"/>
        <TextBox x:Name="OriginalTextBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

        <Label Content="Результат модели"
                       Target="{Binding ElementName=ModelOutputBox}"
                       Margin="0,10,0,0"/>
        <TextBox x:Name="ModelOutputBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

        <Label Content="Как должно быть"
                       Target="{Binding ElementName=ExpectedOutputBox}"
                       Margin="0,10,0,0"/>
        <TextBox x:Name="ExpectedOutputBox"
                         Height="80"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>